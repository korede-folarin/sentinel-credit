# Challenger packages: same rule as the champion's; the models are
# also logged to MLflow (see models/evaluate_feature_removal.py).
models/challengers/
# Every champion package folder (Decision 27): models/artifacts_v1_1/ etc.
models/artifacts_*/
# Public demo site files that ship with it (Decision 29). None are data rows:
# the model contract and parity report hold the feature list, cutoff,
# aggregate ranges and test statistics; parity_vectors.json and
# feature_examples.json hold GENERATED test inputs, not customer records;
# cutoff_simulator.json holds aggregated counts per score band.
!website/public/model/model_contract.json
!website/public/model/python_parity_report.json
!website/public/model/parity_vectors.json
!website/public/model/feature_examples.json
!website/public/data/cutoff_simulator.json
!website/public/model/typical_applicant.json
!website/public/model/reason_templates.json
# Reason wording, typical applicant, decision-check limits (Decisions 30, 31): aggregates only
!serving/reason_templates.json
!serving/typical_applicant.json
!serving/explanation_rules.json
!website/public/model/explanation_rules.json
!website/public/data/review_evidence.json
# Public Streamlit demo snapshot (dashboard/tools/export_demo_data.py): aggregates and
# model files only, no customer records; see dashboard/demo_data/MANIFEST.json
!dashboard/demo_data/
!dashboard/demo_data/**
# v2: the v1 integrity manifest (V2-01) is committed
!v2/manifests/v1_manifest.json
# test outputs
.coverage
coverage.xml
.pytest_cache/
.ruff_cache/
# v2 run outputs: models and raw run reports stay local (results go to v2_results and MLflow)
v2/artifacts/
v2/reports/
# v2 Phase 4: streaming audit files (local stand-in for an S3 bucket) stay local
v2/streaming/audit/
# v2 Phase 2: scaled synthetic datasets (large, regenerable) stay local
v2/data/
